<?xml version="1.0"?>
<package format="3">
  <name>pobs_master_planner</name>
  <version>0.0.3</version>
  <description>Supervisory XY waypoint planner for POBS</description>
  <maintainer email="pobs@example.invalid">POBS team</maintainer>
