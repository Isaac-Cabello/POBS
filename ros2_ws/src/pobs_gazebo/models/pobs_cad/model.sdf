        <material>
          <ambient>0.18 0.22 0.25 1</ambient>
          <diffuse>0.18 0.22 0.25 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="thruster_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_0</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>100</effort>
          <velocity>1000</velocity>
        </limit>
      </axis>
    </joint>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>pobs</namespace>
      <joint_name>thruster_0_joint</joint_name>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <thrust_coefficient>0.004422</thrust_coefficient>
      <use_angvel_cmd>0</use_angvel_cmd>
    </plugin>
