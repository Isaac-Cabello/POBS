<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <model name="pobs_cad">
    <static>false</static>
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>27</mass>
        <inertia>
          <ixx>0.38480625000000007</ixx>
          <iyy>1.4648062500000003</iyy>
          <izz>1.8000000000000005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
        <pose>0 0 -0.025 0 0 0</pose>
        <fluid_added_mass>
          <xx>5</xx>
          <yy>15</yy>
          <zz>20</zz>
          <pp>0.4</pp>
          <qq>1</qq>
          <rr>1.2</rr>
        </fluid_added_mass>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.8 0.4 0.105</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <!-- The CAD STL is in millimeters, with its long axis along CAD Z.
             Rotate it into the robot's X-forward frame and center the casing. -->
        <pose>-0.4042445 -0.2838934 -0.1204642 1.57079632679 0 1.57079632679</pose>
        <geometry>
          <mesh>
            <uri>model://pobs_cad/meshes/Chassis.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.85 0.65 0.05 1</ambient>
          <diffuse>0.85 0.65 0.05 1</diffuse>
        </material>
      </visual>
      <sensor name="pobs_imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <topic>/pobs/imu</topic>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.002</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.002</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.002</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.02</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.02</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.02</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="downward_sonar" type="gpu_lidar">
        <pose>0 0 -0.08 0 1.5707963267948966 0</pose>
        <topic>/pobs/sonar</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>30</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <disable_added_mass>true</disable_added_mass>
      <default_current>0 0 0</default_current>
      <xU>-2</xU>
      <yV>-4</yV>
      <zW>-5</zW>
      <kP>-0.1</kP>
      <mQ>-0.2</mQ>
      <nR>-0.3</nR>
      <xUabsU>-12</xUabsU>
      <yVabsV>-35</yVabsV>
      <zWabsW>-50</zWabsW>
      <kPabsP>-0.5</kPabsP>
      <mQabsQ>-1.5</mQabsQ>
      <nRabsR>-2</nRabsR>
    </plugin>
    <link name="thruster_0">
      <pose>0.28 0.25 0.08 0 -1.5707963267948966 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.0004427083333333334</ixx>
          <iyy>4.270833333333334e-05</iyy>
          <izz>0.00043333333333333337</izz>
