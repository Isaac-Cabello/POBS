        <geometry>
          <box>
            <size>0.16 0.14 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>0.18 0.22 0.25 1</ambient>
          <diffuse>0.18 0.22 0.25 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="starboard_fin_joint" type="fixed">
      <parent>base_link</parent>
      <child>starboard_fin</child>
    </joint>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <link_name>starboard_fin</link_name>
      <air_density>1000</air_density>
      <area>0.0224</area>
      <a0>0</a0>
      <cla>4</cla>
      <cda>0.1</cda>
      <alpha_stall>0.25</alpha_stall>
      <cla_stall>-1</cla_stall>
      <cda_stall>0.5</cda_stall>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <cp>0 0 0</cp>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>20</update_frequency>
    </plugin>
  </model>
</sdf>