<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <model name="lake_terrain">
    <static>true</static>
    <link name="terrain">
      <collision name="terrain_collision">
        <geometry>
          <mesh>
            <uri>model://lake_terrain/meshes/terrain_bumpy.obj</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="terrain_visual">
        <geometry>
          <mesh>
            <uri>model://lake_terrain/meshes/terrain_bumpy.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.32 0.38 0.20 1</ambient>
          <diffuse>0.32 0.38 0.20 1</diffuse>
        </material>
      </visual>
      <visual name="water_surface">
        <geometry>
          <mesh>
            <uri>model://lake_terrain/meshes/water.obj</uri>
          </mesh>
        </geometry>
        <transparency>0.6</transparency>
        <cast_shadows>false</cast_shadows>
        <material>
          <ambient>0.02 0.18 0.5 1</ambient>
          <diffuse>0.02 0.28 0.7 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
